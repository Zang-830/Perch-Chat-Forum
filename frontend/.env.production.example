# Public HTTPS address of the deployed Spring Boot API. Do not include a trailing slash.
VITE_API_BASE_URL=https://api.example.edu

# Use hash routing on GitHub Pages so direct links do not return a 404.
VITE_ROUTER_MODE=hash

# Repository Pages normally uses /repository-name/. A custom domain normally uses /.
VITE_BASE_PATH=/school-chat/
